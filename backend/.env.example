# Environment
SECRET_KEY=changeme-use-a-long-random-string-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Database (SQLite by default — change to postgresql+asyncpg://... for Postgres)
DATABASE_URL=sqlite+aiosqlite:///./credit_recommender.db

# App
APP_NAME="Credit Card Recommender API"
APP_VERSION="1.0.0"
DEBUG=true
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:5173"]
